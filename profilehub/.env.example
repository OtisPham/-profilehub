# ========================================================
# ProfileHub Environment Variables (Môi Trường Cấu Hình)
# ========================================================

# Supabase Cloud Database & Auth
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini AI Key & Model
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Backend API Configuration
PORT=5000

# Client API Base URL
# Khi chạy ở máy tính cá nhân (Local): http://localhost:5000/api
# Khi deploy lên Vercel: https://your-backend-domain.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Client Origin (CORS Whitelist cho Backend)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=https://profilehub.vercel.app,https://yourdomain.com
